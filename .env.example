# Salesforce Marketing Cloud - OAuth2 Client Credentials
SFMC_CLIENT_ID=your_client_id_here
SFMC_CLIENT_SECRET=your_client_secret_here

# Account subdomain (e.g. if your auth URL is https://XXXX.auth.marketingcloudapis.com, use XXXX)
SFMC_SUBDOMAIN=your_subdomain_here

# Optional: specific MID for child Business Units (leave blank for parent BU)
SFMC_ACCOUNT_ID=

# --- Marketing Cloud Personalization (ex-Interaction Studio / Evergage) ---
# Produto separado: auth Basic + base URL própria. Token gerado na UI (Security > API Tokens).

# Base URL via account + instance: https://<account>.<instance>.evergage.com
MCP_PERS_ACCOUNT=your_account_name_here
MCP_PERS_INSTANCE=your_instance_here

# OU sobrescreve a base URL inteira (contas em domínio consolidado). Se setado, ACCOUNT/INSTANCE são ignorados.
MCP_PERS_BASE_URL=

# Dataset default das operações
MCP_PERS_DATASET=your_dataset_here

# Credenciais do API Token (Key ID + Secret) — viram Basic base64(id:secret)
MCP_PERS_API_KEY_ID=your_api_key_id_here
MCP_PERS_API_SECRET=your_api_secret_here
